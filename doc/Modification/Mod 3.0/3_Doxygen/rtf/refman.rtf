{\bkmkstart AAAAAAAAAD}
{\bkmkend AAAAAAAAAD}
Aller \'E0 la documentation de ce fichier.\par
{
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 1 {\cf21 #ifndef MC32DEBOUNCE2_H}\par
2 {\cf21 #define MC32DEBOUNCE2_H}\par
3 \par
4 \par
5 {\cf20 // Mc32Debounce.h}\par
6 \par
7 {\cf20 // C. HUBER    19/02/2014 Portage sur PIC32MX}\par
8 {\cf20 //             Attention int1 transform\'E9 en uint8}\par
9 \par
10 {\cf20 // Fonctions pour la gestion de l'anti-rebond d'un switch}\par
11 {\cf20 //}\par
12 {\cf20 //}\par
13 {\cf20 // Principe : Il est n\'E9cessaire d'appeler cycliquement la fonction DoDebounce}\par
14 {\cf20 //            pour chaque switch. Suggestion cycle de 1 ms}\par
15 {\cf20 //}\par
16 {\cf20 //            Pour la gestion du switch, il y a 3 fonctions \'E0 disposition :}\par
17 {\cf20 //       DebounceGetInput  fourni l'\'E9tat du switch apr\'E9s anti-rebond}\par
18 {\cf20 //       DebounceIsPressed    true indique que l'on vient de presser la touche}\par
19 {\cf20 //       DebounceIsReleased   true indique que l'on vient de relacher la touche}\par
20 {\cf20 //       DebounceClearPressed    annule indication de pression sur la touche}\par
21 {\cf20 //       DebounceClearReleased   annule indication de relachement de la touche}\par
22 {\cf20 //}\par
23 {\cf20 //  Remarques : toute les fonctions utilisent un descripteur de touche}\par
24 {\cf20 //              un \'E9tat 0 indique une touche press\'E9e}\par
25 {\cf20 //}\par
26 {\cf20 //---------------------------------------------------------------------------}\par
27 \par
28 {\cf21 #include <stdbool.h>}\par
29 {\cf21 #include <stdint.h>}\par
30 \par
31 {\cf20 // d\'E9finitions des types qui seront utilis\'E9s dans cette application}\par
32 \par
33 {\cf20 // Etats du syst\'E8me antirebond}\par
34 {\cf17 typedef} {\cf17 enum} \{\par
35       DebounceWaitChange,\par
36       DebounceWaitStable,\par
37 \} E_DebouceStates;\par
38 \par
39 {\cf20 // New}\par
40 {\cf17 typedef} {\cf17 struct }\{\par
41    uint8_t  KeyPressed :1;              {\cf20 // \'E9v\'E9nement touche press\'E9e}\par
42    uint8_t  KeyReleased : 1;             {\cf20 // \'E9v\'E9nement touche relach\'E9e}\par
43    uint8_t  KeyPrevInputValue : 1;       {\cf20 // valeur pr\'E9c\'E9dente de la touche}\par
44    uint8_t  KeyValue : 1;                {\cf20 // valeur finale (image) de la touche}\par
45  \} s_bits;\par
46 \par
47 {\cf20 // structure du descripteur}\par
48 {\cf17 typedef} {\cf17 struct }\{\par
49            E_DebouceStates DebounceState;    {\cf20 // \'E9tat de l'antirebond}\par
50            uint8_t     DebounceCounter;         {\cf20 // compteur}\par
51            s_bits bits;\par
52 \} S_SwitchDescriptor;\par
53 \par
55 {\cf20 // POUR CHAQUE SWITCH DONT ON VEUT EFFECTUER L'ANTI-REBOND DANS L'APPLICATION.}\par
56 {\cf20 // IL FAUDRA DEFINIR UNE VARIABLE DU  TYPE S_SwitchDescriptor}\par
58 {\cf20 //}\par
59 {\cf20 //}\par
60 {\cf20 // DoDebounce (S_SwitchDescriptor *Descriptor, boolean InputValue)}\par
61 {\cf20 //              Routine effectuant la gestion de l'anti-rebond d'un switch}\par
62 {\cf20 //              dont l'adresse de la structure est pass\'E9e en param\'E8tre.}\par
63 {\cf20 //              La valeur du switch lue sur le port est a passer lors de l'appel}\par
64 {\cf20 //}\par
65 {\cf20 // Entr\'E9e: un pointeur sur la structure du switch}\par
66 {\cf20 //         la valeur du switch lue sur le port}\par
67 {\cf20 //}\par
68 {\cf20 // Sortie: la structure mise \'E0 jour}\par
69 {\cf20 //         le bit KeyValue qui donne la valeur du switch apr\'E8s anti-rebond}\par
70 {\cf20 //         le bit KeyPressed qui est mis \'E0 1 d\'E8s que l'on presse sur le switch}\par
71 {\cf20 //           ce bit n'est pas resett\'E9 par cette fonction mais doit l'\'EAtre par l'application}\par
72 {\cf20 //           si elle l'utilise.}\par
73 {\cf20 //         le bit KeyReleased qui est mis \'E0 1 d\'E8s que l'on rel\'E2che sur le switch}\par
74 {\cf20 //           ce bit n'est pas resett\'E9 par cette fonction mais doit l'\'EAtre par l'application}\par
75 {\cf20 //           si elle l'utilise}\par
76 {\cf20 //}\par
77 \par
78 {\cf18 void} DoDebounce (S_SwitchDescriptor *Descriptor, {\cf18 bool} InputValue);\par
79 \par
80 \par
81 {\cf20 /********************************************************************************************/}\par
82 {\cf20 // DebounceInit (S_SwitchDescriptor *pDescriptor) :}\par
83 {\cf20 //              Routine effectuant l'initialisation de la structure d'un switch}\par
84 {\cf20 //              dont l'adresse de la structure est pass\'E9e en param\'E8tre.}\par
85 {\cf20 //}\par
86 {\cf20 // Entr\'E9e: un pointeur sur la structure du switch}\par
87 {\cf20 //}\par
88 \par
89 {\cf18 void} DebounceInit (S_SwitchDescriptor *pDescriptor);\par
90 \par
91 {\cf20 //  DebounceGetInput  fourni l'\'E9tat du switch apr\'E9s anti-rebond}\par
92 {\cf18 bool} DebounceGetInput (S_SwitchDescriptor *pDescriptor);\par
93 \par
94 {\cf20 //  DebounceIsPressed    true indique que l'on vient de presser la touche}\par
95 {\cf18 bool} DebounceIsPressed (S_SwitchDescriptor *pDescriptor);\par
96 \par
97 {\cf20 //  DebounceIsReleased   true indique que l'on vient de relacher la touche}\par
98 {\cf18 bool} DebounceIsReleased (S_SwitchDescriptor *pDescriptor);\par
99 \par
100 {\cf20 //  DebounceClearPressed    annule indication de pression sur la touche}\par
101 {\cf18 void} DebounceClearPressed  (S_SwitchDescriptor *pDescriptor);\par
102 \par
103 {\cf20 //  DebounceClearReleased   annule indication de relachement de la touche}\par
104 {\cf18 void} DebounceClearReleased  (S_SwitchDescriptor *pDescriptor);\par
105 \par
106 {\cf21 #endif}\par
}
